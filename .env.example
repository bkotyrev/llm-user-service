LLM_MODE=auto
LLM_BASE_URL=http://127.0.0.1:8317/v1
LLM_MODEL=gpt-5.4-mini
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=15
LLM_MAX_RETRIES=2
LLM_RETRY_BASE_DELAY=0.25
CACHE_TTL_SECONDS=600
LOG_FILE=logs/service.jsonl

# Заполняется только в локальном окружении.
# CODEX_CLI_TOKEN=

# Необязательная отправка JSON-логов на syslog.
# SYSLOG_HOST=127.0.0.1
# SYSLOG_PORT=514
# SYSLOG_PROTOCOL=udp
# SYSLOG_FACILITY=local0
